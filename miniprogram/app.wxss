@import "styles/tokens.wxss";

page {
  background: var(--bg);
  color: var(--text-1);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: var(--fs-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
input,
textarea,
button {
  box-sizing: border-box;
}

/* 数字对齐：进度、统计、计数 */
.num {
  font-variant-numeric: tabular-nums;
}

/* 主标题 / 区块标题 / 卡片标题 */
.t-display {
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
}
.t-h1 {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-1);
}
.t-h2 {
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-1);
}
.t-h3 {
  font-size: var(--fs-h3);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-1);
}
.t-body {
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: 1.6;
  color: var(--text-1);
}
.t-strong {
  font-size: var(--fs-body);
  font-weight: 500;
}
.t-caption {
  font-size: var(--fs-caption);
  font-weight: 400;
  line-height: 1.5;
  color: var(--text-2);
}
.t-micro {
  font-size: var(--fs-micro);
  font-weight: 500;
  line-height: 1.4;
}

/* 文本截断 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-lg);
}

/* 通用横向内边距容器 */
.gutter {
  padding-left: var(--page-x);
  padding-right: var(--page-x);
}

/* 占位页（第二、三、四阶段实现前保证 tab 可切换） */
.placeholder {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-top: var(--space-6);
}

/* 按压反馈 */
.pressable {
  transition: transform 120ms ease-out;
}
.pressable:active {
  transform: scale(0.98);
}

@media (prefers-reduced-motion: reduce) {
  .pressable,
  .pressable:active {
    transition: none;
    transform: none;
  }
}
