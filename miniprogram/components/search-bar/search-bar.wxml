<view class="search" bindtap="onTap">
  <view class="search__lens"></view>

  <input
    wx:if="{{!readonly}}"
    class="search__input"
    value="{{value}}"
    placeholder="{{placeholder}}"
    placeholder-class="search__ph"
    confirm-type="search"
    bindinput="onInput"
    bindconfirm="onConfirm"
  />

  <text wx:else class="search__text">{{placeholder}}</text>

  <view wx:if="{{!readonly && value}}" class="search__clear" catchtap="onClear">✕</view>
</view>
