.search {
  height: 84rpx;
  padding: 0 var(--space-3);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-full);
}

/* 放大镜：圆环 + 手柄，纯 CSS，避免依赖图标资源 */
.search__lens {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 50%;
  flex: none;
}

.search__lens::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--text-3);
  border-radius: 2rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}

.search__input {
  flex: 1;
  height: 100%;
  font-size: var(--fs-body);
  color: var(--text-1);
}

.search__ph {
  color: var(--text-3);
  font-size: var(--fs-body);
}

.search__text {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search__clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3);
}
