.today {
  position: relative;
  overflow: hidden;
  background: var(--brand-100);
  border-radius: var(--radius-xl);
  padding: var(--space-3);
  min-height: 224rpx;
}

.today.is-finished {
  background: var(--brand-50);
}

.today__main {
  position: relative;
  z-index: 2;
  max-width: 76%;
  display: flex;
  flex-direction: column;
}

.today__kicker {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.today__star {
  font-size: 22rpx;
  color: var(--brand-600);
}

.today__kicker-text {
  font-size: var(--fs-micro);
  color: var(--brand-900);
  opacity: 0.75;
}

.today__title {
  margin-top: 10rpx;
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
}

.today__num {
  color: var(--brand-600);
  font-weight: 600;
}

.today__sub {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.today__cta {
  margin-top: var(--space-3);
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  align-self: flex-start;
  padding-right: var(--space-1);
}

.today__cta--hover {
  opacity: 0.65;
}

.today__cta-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-600);
}

.today__arrow {
  font-size: 28rpx;
  color: var(--brand-600);
  line-height: 1;
}

/* 右侧插画：书 + 铅笔 + 桌面线，纯 CSS，不依赖图片资源 */
.today__art {
  position: absolute;
  right: 8rpx;
  bottom: 0;
  width: 200rpx;
  height: 180rpx;
  z-index: 1;
  pointer-events: none;
}

.art__book {
  position: absolute;
  right: 44rpx;
  bottom: 44rpx;
  width: 100rpx;
  height: 128rpx;
  border-radius: 8rpx 14rpx 14rpx 8rpx;
  background: var(--brand-600);
  transform: rotate(-8deg);
}

.art__spine {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.35);
}

.art__label {
  position: absolute;
  right: 14rpx;
  top: 26rpx;
  width: 52rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.28);
}

.art__pencil {
  position: absolute;
  right: 14rpx;
  bottom: 40rpx;
  width: 12rpx;
  height: 120rpx;
  border-radius: 6rpx;
  background: var(--accent-paper);
  transform: rotate(28deg);
}

.art__line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 36rpx;
  height: 2rpx;
  background: rgba(14, 92, 70, 0.12);
}
