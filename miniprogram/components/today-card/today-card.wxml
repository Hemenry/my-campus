<view class="today {{finished ? 'is-finished' : ''}}">
  <view class="today__main">
    <view class="today__kicker">
      <text class="today__star">✦</text>
      <text class="today__kicker-text">今日学习 · 英语</text>
    </view>

    <view class="today__title">
      <block wx:if="{{finished}}">
        <text>今天的单词已经复习完</text>
      </block>
      <block wx:else>
        <text>还有 </text>
        <text class="today__num num">{{pending}}</text>
        <text> 个单词待复习</text>
      </block>
    </view>

    <text class="today__sub">{{finished ? '打卡已记录，明天继续' : '已连续打卡 ' + streak + ' 天，继续保持'}}</text>

    <view class="today__cta pressable" bindtap="onStart" hover-class="today__cta--hover">
      <text class="today__cta-text">{{finished ? '看看打卡记录' : '开始复习'}}</text>
      <text class="today__arrow">›</text>
    </view>
  </view>

  <view class="today__art">
    <view class="art__pencil"></view>
    <view class="art__book">
      <view class="art__spine"></view>
      <view class="art__label"></view>
    </view>
    <view class="art__line"></view>
  </view>
</view>
