.nav {
  background: var(--bg);
}

.nav__row {
  height: var(--nav-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__brand {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.nav__logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-md);
  background: var(--brand-900);
  color: var(--on-brand);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav__meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
}

.nav__name {
  font-size: var(--fs-h3);
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-1);
}

.nav__school {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 0;
}

.nav__school--hover {
  opacity: 0.6;
}

.nav__school-text {
  font-size: var(--fs-micro);
  color: var(--text-2);
}

.nav__chev {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1;
}

.nav__actions {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.nav__publish {
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav__publish--hover {
  opacity: 0.6;
}

.nav__publish-glyph {
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-1);
}

.nav__bell {
  position: relative;
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav__bell--hover {
  opacity: 0.6;
}

.bell {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bell__body {
  width: 32rpx;
  height: 30rpx;
  border: 3rpx solid var(--text-1);
  border-bottom: none;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  margin-top: 6rpx;
}

.bell__clapper {
  width: 38rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-1);
}

.nav__dot {
  position: absolute;
  top: 18rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent-mistake);
  border: 2rpx solid var(--bg);
}
