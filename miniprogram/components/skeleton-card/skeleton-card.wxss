.sk {
  padding: var(--space-3);
}

.sk__head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.sk__avatar {
  width: var(--avatar-sm);
  height: var(--avatar-sm);
  border-radius: 50%;
  background: var(--surface-sunken);
}

.sk__meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sk__line {
  height: 22rpx;
  border-radius: 6rpx;
  background: var(--surface-sunken);
  margin-bottom: 14rpx;
}

.sk__line:last-child {
  margin-bottom: 0;
}

.sk__line--name {
  width: 200rpx;
}

.sk__line--sub {
  width: 120rpx;
  height: 18rpx;
}

.sk__line--title {
  width: 92%;
  height: 30rpx;
  margin-bottom: 18rpx;
}

/* 呼吸动画：只改透明度，尊重系统减弱动态效果 */
@media (prefers-reduced-motion: no-preference) {
  .sk__line,
  .sk__avatar {
    animation: sk-breathe 1.6s ease-in-out infinite;
  }
}

@keyframes sk-breathe {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}
