.grid {
  display: flex;
  gap: 20rpx;
}

.grid__item {
  flex: 1;
  height: 156rpx;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
}

.grid__item--hover {
  background: var(--brand-50);
}

.grid__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid__glyph {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.grid__label {
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--text-1);
}
