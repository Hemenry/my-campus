.empty {
  padding: var(--space-8) var(--space-5);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty__art {
  position: relative;
  width: 120rpx;
  height: 96rpx;
  margin-bottom: var(--space-3);
}

.empty__sheet {
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 84rpx;
  height: 76rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-100);
  border: 2rpx solid var(--border-soft);
}

.empty__sheet--back {
  left: 24rpx;
  top: 20rpx;
  background: var(--surface);
  border-color: var(--border);
}

.empty__title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-1);
  text-align: center;
}

.empty__desc {
  margin-top: var(--space-1);
  font-size: var(--fs-caption);
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}

.empty__btn {
  margin-top: var(--space-4);
  height: 72rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-full);
  background: var(--brand-600);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__btn-text {
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--on-brand);
}
