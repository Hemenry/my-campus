<view class="post card" bindtap="onTap" hover-class="post--hover">
  <view class="post__head">
    <view class="avatar">
      <text class="avatar__text">{{post.author.avatarText}}</text>
    </view>
    <view class="post__meta">
      <text class="post__name">{{post.author.nickname}} · {{post.author.dept}}</text>
      <text class="post__time">{{post.timeText}}</text>
    </view>
    <text class="tag tag--{{post.typeKey}}">{{post.typeLabel}}</text>
  </view>

  <text class="post__title ellipsis-2">{{post.title}}</text>
  <text wx:if="{{post.excerpt}}" class="post__excerpt ellipsis-2">{{post.excerpt}}</text>

  <view wx:if="{{post.imageCount > 0}}" class="post__media">
    <image wx:if="{{post.cover}}" class="post__img" src="{{post.cover}}" mode="aspectFill" lazy-load />
    <view wx:else class="post__img post__img--ph">
      <text class="post__ph-text">题目图片</text>
    </view>
    <text wx:if="{{post.imageCount > 1}}" class="post__count">共 {{post.imageCount}} 张</text>
  </view>

  <view wx:if="{{post.file}}" class="file">
    <view class="file__icon">
      <text class="file__glyph">▤</text>
    </view>
    <view class="file__meta">
      <text class="file__name">{{post.file.name}}</text>
      <text class="file__sub">{{post.file.pages}} 页 · {{post.file.size}}</text>
    </view>
  </view>

  <view wx:if="{{post.tags.length}}" class="post__tags">
    <text class="chip" wx:for="{{post.tags}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="post__foot">
    <view class="stat">
      <view class="bubble"></view>
      <text class="stat__num num">{{post.answerText}}</text>
    </view>

    <view class="stat stat--tap" catchtap="onLike" hover-class="stat--hover">
      <text class="glyph {{post.liked ? 'is-on' : ''}}">{{post.liked ? '♥' : '♡'}}</text>
      <text class="stat__num num">{{post.likeText}}</text>
    </view>

    <view class="post__spacer"></view>

    <view class="collect stat--tap" catchtap="onCollect" hover-class="stat--hover" aria-label="收藏">
      <text class="glyph {{post.collected ? 'is-on' : ''}}">{{post.collected ? '★' : '☆'}}</text>
    </view>
  </view>
</view>
