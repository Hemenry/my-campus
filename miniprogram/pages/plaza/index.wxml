<view class="page">
  <nav-bar
    show-publish="{{true}}"
    brand-name="GeekCampus"
    school="{{school}}"
    unread="{{unread}}"
    status-bar-height="{{statusBarHeight}}"
    bind:tap-publish="onPublish"
    bind:tap-notify="onNotify"
    bind:tap-school="onSchool"
  />

  <view class="hello gutter">
    <view class="hello__left">
      <text class="t-display">{{greeting}}，{{userName}}</text>
      <text class="hello__sub">把问题分出来，和同学一起学会它。</text>
    </view>
    <text class="hello__date">{{dateText}}</text>
  </view>

  <view class="gutter">
    <search-bar placeholder="搜问题、课程、试卷或单词本" readonly="{{true}}" bind:tap="onSearch" />
  </view>

  <view class="gutter quick">
    <quick-grid items="{{quickItems}}" bind:select="onQuickSelect" />
  </view>

  <view class="gutter today">
    <today-card
      pending="{{today.pending}}"
      streak="{{today.streak}}"
      finished="{{today.finished}}"
      bind:start="onStartReview"
    />
  </view>

  <view class="section gutter">
    <text class="t-h2">学习广场</text>
    <text class="section__more">最新动态 ›</text>
  </view>

  <view class="gutter">
    <segment-tabs items="{{categories}}" active="{{activeIndex}}" bind:change="onTabChange" />
  </view>

  <view class="feed gutter">
    <block wx:if="{{firstLoading}}">
      <view class="feed__item"><skeleton-card rows="3" /></view>
      <view class="feed__item"><skeleton-card rows="3" /></view>
    </block>

    <block wx:elif="{{error}}">
      <empty-state
        title="内容没能加载出来"
        desc="{{error.message}}"
        action-text="重新加载"
        bind:action="onRetry"
      />
    </block>

    <block wx:elif="{{feed.length === 0}}">
      <empty-state
        title="这个分类还没有内容"
        desc="发布第一条，让同学看见你的问题"
        action-text="去发布"
        bind:action="onPublish"
      />
    </block>

    <block wx:else>
      <view class="feed__item" wx:for="{{feed}}" wx:key="id">
        <post-card
          post="{{item}}"
          bind:tap="onPostTap"
          bind:like="onLike"
          bind:collect="onCollect"
        />
      </view>
      <view class="feed__more">
        <text wx:if="{{loadingMore}}" class="feed__more-text">正在加载…</text>
        <text wx:elif="{{!hasMore}}" class="feed__more-text">没有更多了</text>
      </view>
    </block>
  </view>
</view>
