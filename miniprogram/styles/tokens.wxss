/**
 * GeekCampus 设计 token
 * 唯一来源：docs/superpowers/specs/2026-10-20-geekcampus-design.md 第 5 章
 * 单位换算：1px = 2rpx（375 设计稿基准）
 * 规则：页面与组件禁止写裸色值 / 裸字号，一律引用本文件变量
 */
page {
  /* ---------- 品牌与主色：只用于主操作、选中态、进行中 ---------- */
  --brand-900: #0e5c46;
  --brand-600: #1f8a6b;
  --brand-500: #2fa37a;
  --brand-100: #e8f5ef;
  --brand-50: #f3faf6;

  /* ---------- 中性色 ---------- */
  --bg: #f6f8f7;
  --surface: #ffffff;
  --text-1: #1a1f1d;
  --text-2: #6b7a74;
  --text-3: #9aa6a1;
  --border: #e8ecea;

  /* ---------- 功能色：仅用于图标底块与小标签 ---------- */
  --accent-ask: #e8834a;
  --accent-ask-bg: #fdf0e7;
  --accent-mistake: #e05b5b;
  --accent-mistake-bg: #fdecec;
  --accent-material: #4a7fe8;
  --accent-material-bg: #edf2fd;
  --accent-paper: #d9a426;
  --accent-paper-bg: #fcf5e3;
  --accent-warn: #d97706;
  --accent-warn-bg: #fef3e2;
  --accent-danger: #d64545;
  --accent-danger-bg: #fdecec;

  /* ---------- 字号 ---------- */
  --fs-display: 52rpx;
  --fs-h1: 40rpx;
  --fs-h2: 34rpx;
  --fs-h3: 30rpx;
  --fs-body: 28rpx;
  --fs-caption: 24rpx;
  --fs-micro: 22rpx;

  /* ---------- 间距 ---------- */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --page-x: 32rpx;

  /* ---------- 圆角 ---------- */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-full: 999rpx;

  /* ---------- 阴影与描边 ---------- */
  --shadow-card: 0 4rpx 24rpx rgba(16, 40, 32, 0.06);
  --shadow-float: 0 12rpx 48rpx rgba(16, 40, 32, 0.12);
  --hairline: 1rpx solid var(--border);

  /* ---------- 布局 ---------- */
  --nav-h: 88rpx;
  --tabbar-h: 112rpx;
  --avatar-sm: 80rpx;
  --avatar-md: 112rpx;
  --avatar-lg: 144rpx;
  --tap-min: 88rpx;
}
