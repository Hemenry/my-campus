# 复制为 .env 后按本机 MySQL 修改
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=geekcampus

# 也可以直接用完整连接串覆盖上面分项配置
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/geekcampus?charset=utf8mb4

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-to-a-random-string-with-32-bytes-or-more
JWT_EXPIRES_DAYS=7

# 调试开关：本地开发 1（允许默认开发密钥 + Werkzeug 调试器），生产必须 0/不配
FLASK_DEBUG=1

# 跨域白名单，逗号分隔；留空=禁止跨域（同源部署）；* = 任意来源（仅限开发）
# 不配置时默认只放行本地 Vite：http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
